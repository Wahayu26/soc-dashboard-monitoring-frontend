# ==============================================================================
# SOC DASHBOARD FRONTEND - DOCKER ENVIRONMENT CONFIGURATION
# Note: In Next.js, NEXT_PUBLIC_* variables are bundled at build time.
# If deploying via Docker Compose, these can be set as build arguments or in .env.local
# ==============================================================================

# Backend REST API URL (accessible by client browser)
# Example for local testing: http://localhost:8000/api
# Example for production IP:  http://10.100.108.32:8000/api
# Example behind reverse proxy: /api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Reverb WebSocket Credentials (must match backend REVERB_* settings)
NEXT_PUBLIC_REVERB_APP_KEY=soc_dashboard_reverb_key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
